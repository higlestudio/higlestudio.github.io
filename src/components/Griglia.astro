---
// la griglia delle opere in Home: foto quadrata (o la principale) e nome; 2 per riga sul telefono, 4 sul computer
import { percorsi, type Lang } from '../i18n';
import { fondoDi } from '../dati';
interface Props { lang: Lang; opere: any[] }
const { lang, opere } = Astro.props;
// il fondo di ogni foto, preso dalla foto stessa (dati.ts)
const fondi = await Promise.all(opere.map((o) => fondoDi(o.data.foto_quadrata || o.data.foto, o.data.fondo)));
---
<ol class="pannelli inv-grid">
  {opere.map((o, i) => (
    <li>
      <a href={percorsi[lang].opera(o.id)} data-opera>
        <div class="im" style={`--f:${fondi[i]}`}>{(o.data.foto_quadrata || o.data.foto) && <img src={o.data.foto_quadrata || o.data.foto} alt="" loading="lazy" />}</div>
        <div class="cap"><span class="t">{o.data.titolo}</span></div>
      </a>
    </li>
  ))}
</ol>
