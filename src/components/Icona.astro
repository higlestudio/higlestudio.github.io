---
interface Props { nome: 'instagram' | 'mail'; class?: string }
const { nome, class: cls = 'ft-ic' } = Astro.props;
---
{nome === 'instagram'
  ? <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6" fill="currentColor"/></svg>
  : <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg>}
