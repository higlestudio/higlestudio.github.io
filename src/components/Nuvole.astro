---
// in cima alla Home, finché il progetto non ha il suo video (11/10, idea di Simone): nuvole disegnate a vettore, sparse,
// alcune escono dai bordi. Scorrendo salgono, ognuna alla sua velocità, e scoprono "Nuovo progetto", l'anno e il titolo;
// la freccia porta giù alle opere (scripts/nuvole.ts). Le nuvole davanti sono crema, quelle dietro color neutro.
interface Props { sopra: string; anno: number; titolo: string; giu: string }
const { sopra, anno, titolo, giu } = Astro.props;

// 11/10, seconda versione: nuvole gonfie tutte intorno, anche sotto (prima avevano la base piatta). Ogni forma è un gruppo di cerchi
// [x, y, raggio]; il riquadro si calcola da solo, stretto attorno ai cerchi
const forme: Record<string, number[][]> = {
  a: [[30, 60, 26], [62, 40, 32], [100, 30, 36], [138, 42, 30], [166, 62, 24], [140, 74, 24], [100, 78, 26], [60, 76, 24], [100, 55, 34]],
  b: [[30, 62, 24], [55, 38, 28], [88, 30, 32], [118, 48, 26], [128, 72, 22], [95, 82, 24], [58, 82, 22], [80, 58, 30]],
  c: [[22, 44, 18], [50, 30, 24], [86, 22, 28], [124, 26, 26], [158, 36, 22], [184, 48, 16], [150, 58, 18], [110, 60, 20], [70, 58, 20], [40, 56, 16], [100, 42, 24]],
  d: [[24, 46, 18], [48, 30, 22], [76, 28, 20], [96, 44, 16], [74, 56, 18], [46, 56, 16], [60, 44, 20]],
  e: [[28, 60, 24], [52, 38, 26], [86, 26, 32], [124, 34, 28], [152, 54, 24], [132, 76, 22], [96, 82, 24], [58, 80, 22], [90, 56, 32]],
  f: [[26, 50, 20], [54, 32, 26], [90, 26, 26], [120, 40, 22], [132, 58, 16], [104, 66, 20], [66, 66, 22], [36, 62, 16], [80, 48, 26]],
};
const riquadro = (c: number[][]) => {
  const x0 = Math.min(...c.map(([x, , r]) => x - r)), y0 = Math.min(...c.map(([, y, r]) => y - r));
  const x1 = Math.max(...c.map(([x, , r]) => x + r)), y1 = Math.max(...c.map(([, y, r]) => y + r));
  return `${x0} ${y0} ${x1 - x0} ${y1 - y0}`;
};
// posto (% dello schermo, dall'alto: tutte sotto il menu), larghezza (% della larghezza), velocità di salita, deriva di lato, davanti/dietro.
// Distanziate: non si toccano fra loro
const nuvole = [
  { f: 'd', x: 6, y: 14, w: 34, v: 0.5, dx: -0.05, dietro: true },
  { f: 'c', x: 54, y: 23, w: 58, v: 0.8, dx: 0.12, dietro: true },
  { f: 'a', x: 8, y: 36, w: 74, v: 1.5, dx: -0.06, dietro: false },
  { f: 'e', x: -22, y: 60, w: 58, v: 1.1, dx: -0.14, dietro: true },
  { f: 'b', x: 56, y: 66, w: 56, v: 1.9, dx: 0.1, dietro: false },
  { f: 'f', x: 8, y: 86, w: 48, v: 2.3, dx: -0.12, dietro: false },
];
---
<section class="nuvole" aria-labelledby="nv-t">
  <div class="nv-scena">
    <div class="nv-testo">
      <p class="nv-sopra" id="nv-t">{sopra}</p>
      <p class="nv-anno num">{anno}</p>
      <p class="nv-titolo">{titolo}</p>
      <a class="nv-giu" href={giu} aria-label={sopra}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5v14.5" /><path d="m5.5 13 6.5 6.5 6.5-6.5" /></svg>
      </a>
    </div>
    {nuvole.map((n) => (
      <div class:list={['nv', { dietro: n.dietro }]} style={`--x:${n.x}%; --y:${n.y}%; --w:${n.w}; --v:${n.v}; --dx:${n.dx}`} aria-hidden="true">
        <svg viewBox={riquadro(forme[n.f])}>
          {forme[n.f].map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
        </svg>
      </div>
    ))}
  </div>
</section>
<script>import '../scripts/nuvole.ts';</script>
