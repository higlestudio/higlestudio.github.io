---
// in cima alla Home, finché il progetto non ha il suo video (11/10, idea di Simone): nuvole disegnate a vettore, sparse,
// alcune escono dai bordi. Scorrendo salgono, ognuna alla sua velocità, e scoprono "Nuovo progetto", l'anno e il titolo;
// la freccia porta giù alle opere (scripts/nuvole.ts).
interface Props { sopra: string; anno: number; titolo: string; giu: string }
const { sopra, anno, titolo, giu } = Astro.props;

// 11/10, terza versione: stile fumetto pop (scelto da Simone). Pochi bozzi grandi sopra una base arrotondata, contorno nero spesso,
// le linee nere dove un bozzo entra nell'altro, e un'ombra piatta sfalsata in basso a destra (senza, il contorno nero sul fondo nero non si vede).
// Ogni forma: base [x, y, larghezza, altezza] + bozzi [x, y, raggio]; il riquadro si calcola da solo
type Forma = { base: number[]; bozzi: number[][] };
const forme: Record<string, Forma> = {
  a: { base: [15, 55, 170, 40], bozzi: [[45, 58, 30], [90, 42, 40], [138, 52, 32], [168, 68, 20]] },
  b: { base: [12, 70, 140, 36], bozzi: [[42, 68, 28], [82, 48, 40], [124, 64, 28]] },
  c: { base: [10, 46, 220, 30], bozzi: [[40, 46, 24], [82, 34, 32], [128, 30, 32], [172, 40, 26], [208, 52, 16]] },
  d: { base: [10, 46, 104, 28], bozzi: [[36, 46, 22], [68, 36, 28], [98, 50, 16]] },
  e: { base: [18, 78, 184, 36], bozzi: [[52, 78, 30], [94, 54, 42], [146, 62, 36], [186, 84, 20]] },
  f: { base: [12, 52, 130, 30], bozzi: [[40, 54, 24], [78, 40, 32], [118, 52, 22]] },
};
const BORDO = 6, OMBRA = 7; // spessore del contorno e spostamento dell'ombra, in unità del disegno
const riquadro = ({ base: [bx, by, bw, bh], bozzi }: Forma) => {
  const x0 = Math.min(bx, ...bozzi.map(([x, , r]) => x - r)) - BORDO, y0 = Math.min(by, ...bozzi.map(([, y, r]) => y - r)) - BORDO;
  const x1 = Math.max(bx + bw, ...bozzi.map(([x, , r]) => x + r)) + BORDO + OMBRA, y1 = Math.max(by + bh, ...bozzi.map(([, y, r]) => y + r)) + BORDO + OMBRA;
  return `${x0} ${y0} ${x1 - x0} ${y1 - y0}`;
};
// la linea dove un bozzo entra in quello prima: un pezzo del suo bordo, sul lato sinistro in basso
const piega = ([x, y, r]: number[]) => {
  const p = (g: number) => `${(x + r * Math.cos((g * Math.PI) / 180)).toFixed(1)} ${(y + r * Math.sin((g * Math.PI) / 180)).toFixed(1)}`;
  return `M${p(150)} A${r} ${r} 0 0 1 ${p(200)}`;
};
// posto (% dello schermo, dall'alto: tutte sotto il menu), larghezza (% della larghezza), velocità di salita, deriva di lato, davanti/dietro.
// Distanziate: non si toccano fra loro
const nuvole = [
  { f: 'd', x: 6, y: 14, w: 34, v: 0.5, dx: -0.05, dietro: true },
  { f: 'c', x: 54, y: 23, w: 58, v: 0.8, dx: 0.12, dietro: true },
  { f: 'a', x: 8, y: 36, w: 74, v: 1.5, dx: -0.06, dietro: false },
  { f: 'e', x: -22, y: 60, w: 58, v: 1.1, dx: -0.14, dietro: true },
  { f: 'b', x: 56, y: 66, w: 56, v: 1.9, dx: 0.1, dietro: false },
  { f: 'f', x: 8, y: 86, w: 48, v: 2.3, dx: -0.12, dietro: false },
];
---
<section class="nuvole" aria-labelledby="nv-t">
  <div class="nv-scena">
    <div class="nv-testo">
      <p class="nv-sopra" id="nv-t">{sopra}</p>
      <p class="nv-anno num">{anno}</p>
      <p class="nv-titolo">{titolo}</p>
      <a class="nv-giu" href={giu} aria-label={sopra}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5v14.5" /><path d="m5.5 13 6.5 6.5 6.5-6.5" /></svg>
      </a>
    </div>
    {nuvole.map((n) => {
      const s = forme[n.f];
      const [bx, by, bw, bh] = s.base;
      // la sagoma: base + bozzi. Disegnata tre volte: ombra, contorno (più spesso), pieno
      const sagoma = <>
        <rect x={bx} y={by} width={bw} height={bh} rx={bh / 2} />
        {s.bozzi.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
      </>;
      return <div class:list={['nv', { dietro: n.dietro }]} style={`--x:${n.x}%; --y:${n.y}%; --w:${n.w}; --v:${n.v}; --dx:${n.dx}`} aria-hidden="true">
        <svg viewBox={riquadro(s)}>
          <g class="nv-ombra" transform={`translate(${OMBRA} ${OMBRA})`} stroke-width={BORDO * 2}>{sagoma}</g>
          <g class="nv-bordo" stroke-width={BORDO * 2}>{sagoma}</g>
          <g class="nv-pieno">{sagoma}</g>
          <g class="nv-pieghe" stroke-width={BORDO * 0.7}>{s.bozzi.slice(1).map((b) => <path d={piega(b)} />)}</g>
        </svg>
      </div>;
    })}
  </div>
</section>
<script>import '../scripts/nuvole.ts';</script>
