---
import Logomark from './Logomark.astro';
import { percorsi, testi, type Lang } from '../i18n';
import { sito } from '../dati';
interface Props { lang: Lang; pagina?: string | null; altra: string }
const { lang, pagina, altra } = Astro.props;
const altraLang: Lang = lang === 'it' ? 'en' : 'it';
const t = testi[lang];
const p = percorsi[lang];
const s = await sito();
const anno = new Date().getFullYear();
---
<!-- 9/10, dal disegno di Simone: in alto il logo nella sua casella (toccato si rompe, i petali rimbalzano e si torna in Home: scripts/piede.ts)
     e accanto Home, Work, About; poi newsletter, Instagram, la mail, note legali -->
<script>import '../scripts/piede.ts';</script>
<footer class="pannelli ft">
  <div class="ft-testa">
    <a href={p.home} class="ft-logo" aria-label="Higle Studio, Home"><Logomark /></a>
    <nav class="ft-nav" aria-label={t.menu}>
      <a href={p.home} aria-current={pagina === 'home' ? 'page' : undefined}><span>{t.home}</span></a>
      <a href={p.archivio} aria-current={pagina === 'archivio' ? 'page' : undefined}><span>{t.archivio}</span></a>
      <a href={p.contatti} aria-current={pagina === 'contatti' ? 'page' : undefined}><span>{t.contatti}</span></a>
    </nav>
  </div>
  <div class="cella nlc">
    <form class="nl" id="nl" novalidate data-lingua={lang.toUpperCase()}
      data-ok={t.nlOk} data-non-valida={t.nlNonValida} data-errore={t.nlErrore} data-spenta={t.nlSpenta}
      data-nota={`${t.nlNota} ${t.nlNotaLink}${t.nlNotaFine}`}>
      <label for="nl-email" class="sr">{t.tuaEmail}</label>
      <input id="nl-email" name="EMAIL" type="email" placeholder={t.tuaEmail} autocomplete="email" />
      <input class="trappola" name="email_address_check" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit">{t.iscriviti}</button>
    </form>
    <p class="nl-nota">{t.nlNota} <a href={p.privacy}>{t.nlNotaLink}</a>{t.nlNotaFine}</p>
    <p class="nl-ok" id="nl-ok" role="status"></p>
  </div>
  <a class="ft-ig" href={`https://instagram.com/${s.instagram}`} target="_blank" rel="noopener"><span>Instagram</span></a>
  <a class="ft-ig ft-mail" href={`mailto:${s.email}`}><span>{s.email}</span></a>
  <div class="cella piede">
    <nav class="legali" aria-label={t.noteLegali}>
      <a href={p.privacy}>{t.privacy}</a>
      <a href={`${p.privacy}#impressum`}>{t.impressum}</a>
      <a href={altra} class="lingua" lang={altraLang} hreflang={altraLang}>{t.altraLinguaNome}</a>
    </nav>
    <span class="num">© {anno} Higle Studio</span>
  </div>
</footer>
