---
import Base from '../../layouts/Base.astro';
import Logomark from '../Logomark.astro';
import Griglia from '../Griglia.astro';
import Nuvole from '../Nuvole.astro';
import { percorsi, testi, type Lang } from '../../i18n';
import { cicloInPrimoPiano, opere, titoloCiclo, statement } from '../../dati';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = testi[lang];
const p = percorsi[lang];
const altra: Lang = lang === 'it' ? 'en' : 'it';
const ciclo = await cicloInPrimoPiano();
const lista = await opere(ciclo.id);
const titolo = titoloCiclo(ciclo, lang);
const it = lang === 'it';
const { video, copertina } = ciclo.data;
const eventi = ciclo.data.eventi.filter((e) => e.attivo);
// sotto le opere, il primo paragrafo dello statement
const { lead } = statement(it ? ciclo.data.statement_it : ciclo.data.statement_en);
---
<Base lang={lang} titolo={`Higle Studio | ${titolo}`} descrizione={titolo} pagina="home" altra={percorsi[altra].home}>
  <!-- ingresso: a ogni ricarica della Home e a ogni arrivo da fuori; non tornando da un'altra pagina del sito né col tasto indietro.
       Su nero i petali compongono il logo al centro, poi il nero si dissolve e sotto c'è la pagina (hero.ts). Mai oltre 4,5 secondi. -->
  <div class="ingresso" aria-hidden="true" slot="prima">
    <script is:inline>
      try {
        var tipo = (performance.getEntriesByType('navigation')[0] || {}).type, interno = false;
        try { interno = !!document.referrer && new URL(document.referrer).host === location.host; } catch (e) {}
        var daFuori = sessionStorage.getItem('higle-da-fuori'); sessionStorage.removeItem('higle-da-fuori');
        var parte = tipo === 'reload' || (tipo !== 'back_forward' && (!interno || daFuori));
        if (parte && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('intro');
          setTimeout(function () { document.documentElement.classList.remove('intro', 'intro-resto'); }, 4500);
        }
      } catch (e) {}
    </script>
    <Logomark />
  </div>
  <h1 class="sr">Higle Studio</h1>

  <!-- in cima il video del progetto, se c'è (dal pannello). 11/10: finché manca, le nuvole che salgono e scoprono il progetto -->
  {video
    ? <section class="video" aria-label={t.video}><video src={video} poster={copertina} autoplay muted loop playsinline preload="metadata"></video></section>
    : <Nuvole sopra={t.nuovoProgetto} anno={ciclo.data.anno} giu="#opere" />}

  <!-- gli eventi, ognuno con la sua locandina, nell'ordine del pannello (11/10: possono essere più di uno; si spengono uno per uno) -->
  {eventi.map((e, i) => {
    const titoloEvento = it ? e.titolo_it : e.titolo_en;
    const dataEvento = it ? e.data_it : e.data_en;
    const luogoEvento = it ? e.luogo_it : e.luogo_en;
    // la locandina porta al link dell'evento, se c'è
    const Locandina = e.link ? 'a' : 'div';
    return <section class="pannelli prog-home evento" aria-labelledby={`evento-${i}`}>
      <!-- come un biglietto: il titolo grande, sotto data e luogo affiancati -->
      <h2 class="cella evento-t" id={`evento-${i}`}>{titoloEvento}</h2>
      {(dataEvento || luogoEvento) && <dl class="evento-info">
        {dataEvento && <div class="cella"><dt>{t.data}</dt><dd>{dataEvento}</dd></div>}
        {luogoEvento && <div class="cella"><dt>{t.luogo}</dt><dd>{luogoEvento}</dd></div>}
      </dl>}
      {e.locandina && <Locandina class="cella locandina" href={e.link}>
        <img src={e.locandina} alt={titoloEvento} loading="lazy" />
      </Locandina>}
    </section>;
  })}

  <!-- poi il progetto: il titolo con un po' di testo, le opere in griglia, "Scopri tutto il progetto" (11/10: testo e galleria scambiati) -->
  <section class="prog-opere" aria-labelledby="prog-t" id="opere">
    <div class="pannelli prog-home prog-intro"><div class="cella">
      <h2 id="prog-t">{titolo}</h2>
      {lead && <p class="prog-lead" set:html={lead} />}
    </div></div>
    <Griglia lang={lang} opere={lista} />
    <!-- verso Work (11/10): una pillola crema con la scritta nera, al centro, con spazio sopra e sotto: staccata dal piede -->
    <div class="scopri-pillola">
      <a href={p.archivio}>{t.scopri} <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
<script>import '../../scripts/hero.ts'; import '../../scripts/rivela.ts';</script>
