---
import Base from '../../layouts/Base.astro';
import Freccia from '../Freccia.astro';
import { percorsi, testi, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = testi[lang];
const altra: Lang = lang === 'it' ? 'en' : 'it';
---
<!-- iscrizione confermata (11/10): ci si arriva dal clic nella mail di conferma di Brevo, un modulo per lingua.
     "Grazie" grande, la frase sotto, e la pillola crema per tornare in Home (come "Scopri tutto il progetto"). Mai su Google. -->
<Base lang={lang} titolo={`${t.nlTitolo} | Higle Studio`} altra={percorsi[altra].newsletter} automatica={false} nascosta>
  <section class="vuoto nl-grazie">
    <h1 class="vuoto-404 nl-ci-sei">{t.nlCiSei}</h1>
    <p class="vuoto-frase">{t.nlConfermata}</p>
    <div class="scopri-pillola"><a href={percorsi[lang].home}><span class="pl-t">{t.vaiHome}</span><Freccia /></a></div>
  </section>
</Base>
