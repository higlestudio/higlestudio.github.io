---
import Base from '../../layouts/Base.astro';
import { percorsi, testi, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = testi[lang];
const altra: Lang = lang === 'it' ? 'en' : 'it';
---
<!-- iscrizione confermata (11/10): ci si arriva dal clic nella mail di conferma di Brevo, un modulo per lingua.
     Stessa forma della 404: una parola grande, una riga, la casella crema per tornare in Home. Mai su Google. -->
<Base lang={lang} titolo={`${t.nlTitolo} | Higle Studio`} altra={percorsi[altra].newsletter} automatica={false} nascosta>
  <section class="vuoto">
    <h1 class="vuoto-404 nl-ci-sei">{t.nlCiSei}</h1>
    <p class="vuoto-frase">{t.nlConfermata}</p>
  </section>
  <div class="pannelli scopri-box vuoto-box">
    <a class="cella scopri" href={percorsi[lang].home}>{t.vaiHome} <span aria-hidden="true">→</span></a>
  </div>
</Base>
