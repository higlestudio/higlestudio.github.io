---
import Base from '../../layouts/Base.astro';
import { percorsi, testi, type Lang } from '../../i18n';
import { titoloCiclo, md } from '../../dati';
import { getEntry } from 'astro:content';
interface Props { lang: Lang; opera: any }
const { lang, opera } = Astro.props;
const t = testi[lang];
const altra: Lang = lang === 'it' ? 'en' : 'it';
const o = opera.data;
const ciclo = (await getEntry('cicli', o.ciclo))!;
const nomeCiclo = titoloCiclo(ciclo, lang);
const it = lang === 'it';
const foto = [o.foto, ...o.altre_foto];
---
<Base lang={lang} titolo={`${o.titolo} | Higle Studio`} pagina="archivio" descrizione={`${o.titolo}, ${o.anno}. ${nomeCiclo}`} altra={percorsi[altra].opera(opera.id)}>
  <figure class="op-foto" style={`--f:${o.fondo}`}>
    <div class="sfoglia" tabindex={foto.length > 1 ? 0 : undefined} aria-label={foto.length > 1 ? `${t.foto}: ${o.titolo}` : undefined}>
      {foto.map((f, n) => <img src={f} alt={foto.length > 1 ? `${o.titolo}, ${n + 1}/${foto.length}` : o.titolo} loading={n ? 'lazy' : 'eager'} />)}
    </div>
  </figure>
  {foto.length > 1 && (
    <div class="trattini" aria-label={`${t.foto}: ${o.titolo}`}>
      {foto.map((_, n) => <button type="button" aria-label={`${t.foto} ${n + 1}/${foto.length}`} aria-current={n === 0 ? 'true' : undefined}></button>)}
    </div>
  )}
  <!-- 9/10: il nome, poi i dati in una griglia a caselle come nel piede (anno, materiali, misure, edizione; il progetto a tutta riga),
       poi il testo dell'opera. Per ora niente statement del progetto né altre opere -->
  <section class="pannelli op-blocco">
    <div class="cella op-testa"><h1 class="op-t">{o.titolo}</h1></div>
    <dl class="op-griglia num">
      <div class="cella"><dt>{t.anno}</dt><dd>{o.anno}</dd></div>
      <div class="cella"><dt>{t.materiali}</dt><dd>{it ? o.materiali_it : o.materiali_en}</dd></div>
      <div class="cella"><dt>{t.misure}</dt><dd>{o.misure}</dd></div>
      <div class="cella"><dt>{t.edizione}</dt><dd>{it ? o.edizione_it : o.edizione_en}</dd></div>
      <div class="cella op-prog"><dt>{t.ciclo}</dt><dd>{nomeCiclo}</dd></div>
    </dl>
    {(it ? o.testo_it : o.testo_en).trim() && <div class="cella"><div class="op-testo" set:html={md(it ? o.testo_it : o.testo_en)} /></div>}
  </section>
</Base>
<script>import '../../scripts/rivela.ts';</script>
