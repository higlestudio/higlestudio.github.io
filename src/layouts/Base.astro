---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '../styles/global.css';
import Piede from '../components/Piede.astro';
import Freccia from '../components/Freccia.astro';
import { percorsi, testi, type Lang } from '../i18n';
import { LANCIATO } from '../lancio';

interface Props {
  lang: Lang;
  titolo: string;
  descrizione?: string;
  pagina?: 'home' | 'archivio' | 'contatti' | null;

  altra: string;

  automatica?: boolean;

  nascosta?: boolean;
}
const { lang, titolo, descrizione = '', pagina = null, altra, automatica = true, nascosta = false } = Astro.props;
const t = testi[lang];
const p = percorsi[lang];
const qui = new URL(Astro.url.pathname, Astro.site);
const enUrl = new URL(lang === 'en' ? Astro.url.pathname : altra, Astro.site);
const itUrl = new URL(lang === 'it' ? Astro.url.pathname : altra, Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  {automatica && <script is:inline define:vars={{ lingua: lang, altra }}>    try {
      const daFuori = !document.referrer || new URL(document.referrer).host !== location.host;
      const robot = /bot|crawl|spider|slurp|lighthouse|facebookexternalhit/i.test(navigator.userAgent);
      if (daFuori && !robot) {
        const voluta = localStorage.getItem('higle-lingua') || (/^it\b/i.test(navigator.language || '') ? 'it' : 'en');

        if (voluta !== lingua) { try { sessionStorage.setItem('higle-da-fuori', '1'); } catch (e) {} location.replace(altra + location.hash); }
      }
    } catch (e) {}
</script>}
  {(!LANCIATO || nascosta) && <meta name="robots" content="noindex, nofollow" />}
  <title>{titolo}</title>
  {descrizione && <meta name="description" content={descrizione} />}
  <link rel="canonical" href={qui} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="it" href={itUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />
  <meta property="og:title" content={titolo} />
  {descrizione && <meta property="og:description" content={descrizione} />}
  <meta property="og:url" content={qui} />
  <meta name="theme-color" content="#292724" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Higle Studio" />
  <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
  <meta property="og:image" content={new URL('/og.png', Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Higle Studio" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="32x32 48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <link rel="apple-touch-icon-precomposed" href="/apple-touch-icon.png?v=2" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/Nohemi-Bold.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body data-pagina={pagina}>
  <div class="cur" aria-hidden="true"><span class="cur-t">{t.apri}</span><span class="cur-frecce"><Freccia verso="sinistra" /><Freccia verso="destra" /></span></div>
  <slot name="prima" />
  <nav class="pill-nav" aria-label={t.menu}>
    <span class="pn-group">
      <a href={p.home} aria-current={pagina === 'home' ? 'page' : undefined}>{t.home}</a>
      <a href={p.archivio} aria-current={pagina === 'archivio' ? 'page' : undefined}>{t.archivio}</a>
      <a href={p.contatti} aria-current={pagina === 'contatti' ? 'page' : undefined}>{t.contatti}</a>
    </span>
  </nav>
  <main>
    <slot />
    <Piede lang={lang} pagina={pagina} altra={altra} />
  </main>
  <script>import '../scripts/sito.ts'; import '../scripts/rivela.ts';</script>
</body>
</html>
