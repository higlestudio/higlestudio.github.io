---
import Base from '../layouts/Base.astro';
import Logomark from '../components/Logomark.astro';
---
<Base lang="en" titolo="404 | Higle Studio" altra="/it/" automatica={false}>
  <!-- pagina che non esiste: 404 grande, una frase, e sotto il logo rotto. Toccato, si ricompone e si torna in Home.
       Un solo file per tutte le lingue: lo script mostra l'italiano se l'indirizzo era sotto /it/ o il telefono è in italiano. -->
  <section class="vuoto">
    <h1 class="vuoto-404">404</h1>
    <p class="vuoto-frase" data-lingua="en">Nothing here.</p>
    <p class="vuoto-frase" data-lingua="it" lang="it" hidden>Qui non c'è niente.</p>
    <button type="button" class="vuoto-petali" aria-label="Home"><Logomark /></button>
    <noscript><style>.vuoto-petali { visibility: visible; }</style></noscript>
  </section>
</Base>
<script>import '../scripts/vuoto.ts';</script>
